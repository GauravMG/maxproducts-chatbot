# ---- Postgres ----
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
# Use "postgres:5432" as host inside docker compose, "localhost:5433" when running the server on your host
# (host port 5433 avoids clashing with a locally installed Postgres on 5432)
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5433/chatbot

# ---- OpenAI ----
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# ---- WordPress / WooCommerce integration ----
# mock = fully self-contained, no real WordPress needed (default for local dev)
# live = calls the real WooCommerce REST API + the mpe-chatbot companion plugin
WP_MODE=mock
WP_SITE_URL=https://maxpowereu.com
WP_REST_NAMESPACE=mpe-chatbot/v1
# Must match the "MPE Chatbot" settings page shared secret when WP_MODE=live
WP_SHARED_SECRET=replace-with-a-long-random-32-byte-secret

# Store-wide WooCommerce REST API keys (read-only informational data: products/pages)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# ---- Invoices ----
# backend_pdf = Express renders the PDF itself from order data (default, no WP plugin needed)
# wp_plugin_url = delegate to a WP invoice plugin's own download URL
INVOICE_STRATEGY=backend_pdf

# ---- Server ----
PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://maxpowereu.com
TOKEN_TTL_SECONDS=900
# Enables POST /api/dev/mock-login for local testing without WordPress. NEVER enable in production.
ENABLE_DEV_AUTH=true

# Only read by docker-compose.prod.yml — the HOST port the server container is published
# to (bound to 127.0.0.1; nginx reverse-proxies to it). Change this if it collides with
# another service already running on the host, e.g. 4001 if 4000 is taken.
SERVER_HOST_PORT=4001

# ---- Widget (Vite) ----
VITE_CHATBOT_API_URL=http://localhost:4000
